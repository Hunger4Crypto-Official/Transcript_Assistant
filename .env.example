# Copy to .env and fill in. Never commit .env.
# Load it with:  set -a; source .env; set +a

# ---- vault (REQUIRED) ------------------------------------------------------
# Encrypts every high and maximum sensitivity artifact at rest. Minimum 16
# characters. There is no recovery. Put it in your password manager now, before
# you process anything you would be upset to lose.
PLAUD_BRIDGE_PASSPHRASE=

# ---- cloud providers (optional) --------------------------------------------
# Used only by the sales_trainer profile. The father, husband, insurance_agent,
# and unfiled profiles will never touch these regardless of what you set here.
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# ---- speaker diarization (optional) ----------------------------------------
# Accept the model licence at huggingface.co/pyannote/speaker-diarization-3.1
HUGGINGFACE_TOKEN=
