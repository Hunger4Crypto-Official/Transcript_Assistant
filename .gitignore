.env
*.enc
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.venv/
venv/
*.egg-info/
build/
dist/
.DS_Store

# Windows-app build artifacts, generated fresh by the build (never committed):
# the icon is drawn by packaging/make_icon.py and ffmpeg is downloaded in CI.
packaging/icon.ico
packaging/bin/
*.spec.bak

# Recordings, transcripts, the vault, and the index never go near a remote.
# The inbox placeholder is tracked so a fresh clone has somewhere to drop files;
# nothing else under data/ is.
data/*
!data/inbox/
data/inbox/*
!data/inbox/README.txt

